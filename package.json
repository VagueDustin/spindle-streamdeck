{
	"name": "spindle-streamdeck",
	"version": "1.0.0",
	"description": "Now Playing for Home Assistant on a Stream Deck+ dial.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.vaguedustin.spindle\"",
		"test": "vitest run",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate com.vaguedustin.spindle.sdPlugin",
		"icons": "tsx scripts/build-icons.ts",
		"scrub": "tsx scripts/scrub.ts",
		"version": "node scripts/sync-version.mjs && git add com.vaguedustin.spindle.sdPlugin/manifest.json",
		"gen:widths": "tsx scripts/gen-width-table.ts",
		"screenshots": "tsx scripts/render-screenshots.ts",
		"gallery:captures": "tsx scripts/compose-captures.ts"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.2",
		"jpeg-js": "^0.4.4",
		"pngjs": "^7.0.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.2",
		"@resvg/resvg-js": "^2.6.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@tsconfig/node20": "^20.1.10",
		"@types/node": "~26.6.5",
		"@types/opentype.js": "^1.3.10",
		"@types/pngjs": "^6.0.5",
		"@types/ws": "^8.18.2",
		"eslint": "^10.12.0",
		"gifenc": "^1.0.3",
		"opentype.js": "^2.0.0",
		"rollup": "^4.64.6",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.4",
		"ws": "^8.22.0"
	}
}
